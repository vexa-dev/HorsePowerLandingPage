# --- Copia este archivo como .env.local y completa los valores ---

# Número de WhatsApp de la empresa, con código de país, solo dígitos.
# Ej: 51987654321  (Perú +51)
NEXT_PUBLIC_WHATSAPP=

# CSV publicado de la Google Sheet del catálogo.
# En la Sheet: Archivo -> Compartir -> Publicar en la web -> (hoja) -> CSV.
# Si se deja vacío, la web usa src/data/catalogo.csv del repo.
GOOGLE_SHEET_CSV_URL=

# Token secreto para el endpoint /api/revalidar (revalidación instantánea del
# catálogo desde el Google Apps Script). Genera una cadena larga aleatoria y
# usa EXACTAMENTE el mismo valor en el script de la hoja.
REVALIDAR_TOKEN=

# Dominio final (sin barra al final).
NEXT_PUBLIC_SITIO_URL=https://horsepower.pe

# Google Analytics 4 (opcional). Ej: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Datos de la tienda para el pie de página (opcionales).
NEXT_PUBLIC_DIRECCION=
# Coordenadas exactas de la tienda para el pin del mapa en /ubicanos.
# En maps.google.com: clic derecho sobre el local -> clic en las coordenadas para copiarlas.
# Formato: -12.047123 y -77.024560 (por separado).
NEXT_PUBLIC_TIENDA_LAT=
NEXT_PUBLIC_TIENDA_LNG=
# Métodos de pago aceptados en tienda, separados por comas (opcional).
# Ej: Efectivo, Yape, Plin, Visa, Mastercard
NEXT_PUBLIC_METODOS_PAGO=
NEXT_PUBLIC_HORARIO=
NEXT_PUBLIC_TELEFONO_CONTACTO=
NEXT_PUBLIC_EMAIL_CONTACTO=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_LIBRO_RECLAMACIONES=
